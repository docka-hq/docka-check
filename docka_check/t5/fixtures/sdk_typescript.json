{
 "_source": "official MCP TypeScript SDK 1.30.1 + zod 4.6.5",
 "tools": [
  {
   "name": "create_task",
   "description": "Create a task",
   "inputSchema": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "estimate_hours": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "priority": {
      "default": "low",
      "type": "string",
      "enum": [
       "low",
       "high"
      ]
     },
     "assignee": {
      "type": [
       "string",
       "null"
      ]
     },
     "address": {
      "type": "object",
      "properties": {
       "city": {
        "type": "string"
       }
      },
      "required": [
       "city"
      ]
     }
    },
    "required": [
     "title",
     "estimate_hours"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "execution": {
    "taskSupport": "forbidden"
   }
  }
 ]
}